# Copy to .env and adjust.  Real environment variables override this file.

# ---------- Honeypot ----------
# 127.0.0.1 = local testing only. Use 0.0.0.0 only on an isolated VM/VPS.
HP_BIND_HOST=127.0.0.1
HP_PORT=2222
HP_DB_PATH=data/honeypot.db
HP_HOST_KEY=data/host_rsa.key
HP_LOG_FILE=data/honeypot.log
HP_JSONL_FILE=data/events.jsonl
HP_JSONL_ENABLED=true
# Delete sessions older than N days at startup (0 = keep forever)
HP_RETENTION_DAYS=0

# What attackers see
HP_SSH_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.6
HP_HOSTNAME=srv-prod-01

# Auth policy: list | after_n | any | never
HP_AUTH_MODE=list
HP_ACCEPTED_CREDS=root:root,root:123456,root:password,root:admin,admin:admin,ubuntu:ubuntu,pi:raspberry
HP_ACCEPT_AFTER=3

# Limits
HP_MAX_CONNECTIONS=100
HP_MAX_PER_IP=5
HP_MAX_AUTH_ATTEMPTS=6
# Public-key offers logged per session (bots can send hundreds)
HP_MAX_KEY_ATTEMPTS=10
HP_AUTH_TIMEOUT=30
HP_IDLE_TIMEOUT=120
HP_SESSION_TIMEOUT=600
HP_MAX_LINE_LENGTH=4096
HP_MAX_COMMANDS=500

# ---------- Dashboard ----------
DASH_HOST=127.0.0.1
DASH_PORT=5000
DASH_USER=admin
# Required if DASH_HOST is not loopback. Use a long random value.
DASH_PASSWORD=
DASH_REFRESH=30
